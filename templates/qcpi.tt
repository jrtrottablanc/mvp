elcJob=$(sbatch --parsable ${jobCmd})
if [ $? != 0 ]; then echo "ERROR : Cannot submit [${jobCmd}] [${cmdFile}]" >> ${errLog}; exit 1; fi
echo -e "${jobCmd}\t${elcJob}" | tee -a ${jobLog} >&2
	
#-----------------#
# qcpi.cbdbc      #
#-----------------#
jobLab="[% levelId %].qcpi.cbdbc"
jobCmd="[% stepDir %]/${jobLab}.cmd"
jobLog="[% stepDir %]/${jobLab}.jobID.log"
echo "# INFO - Submitting qcpi.cbdbc ..." >&2
apptainer run --bind ${bindDir} ${contDir}/${perlCont} tpage \
--define qos=${qcpi_cbdbc_qos} \
--define cpu=${qcpi_cbdbc_cpu} \
--define mem=${qcpi_cbdbc_mem} \
--define time="${qcpi_cbdbc_time}" \
--define excludeNode=[% excludeNode %] \
--define jobLab=${jobLab} \
--define confFile=[% confFile %] \
--define stepDir=[% stepDir %] \
--define input=[% input %] \
--define levelId=[% levelId %] \
