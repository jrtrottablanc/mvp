--define cpu=${qcpi_cgcbm_cpu} \
--define mem=${qcpi_cgcbm_mem} \
--define time="${qcpi_cgcbm_time}" \
--define excludeNode=[% excludeNode %] \
--define jobLab=${jobLab} \
