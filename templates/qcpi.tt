#!/bin/bash
#SBATCH --exclude=[% excludeNode %]
#SBATCH --job-name=[% jobLab %]
#SBATCH --chdir=[% stepDir %]
#SBATCH --partition=genD
#SBATCH --requeue
#SBATCH --output=[% jobLab %]_%j.out 
#SBATCH --error=[% jobLab %]_%j.err 
#SBATCH --ntasks=1
#SBATCH --qos=[% qos %]
#SBATCH --cpus-per-task=[% cpu %]
#SBATCH --mem-per-cpu=[% mem %]
#SBATCH --time=[% time %]

hostname >&2
printf START >&2; uptime >&2
date >&2

export LC_ALL=C

cmdFile="[% stepDir %]/[% jobLab %].cmd"
errLog="[% stepDir %]/ERROR.log"

source [% confFile %]
source ${confDir}/${pipeConf%.conf}_ROI_[% app %].conf

#-----------------#
# qcpi.casm       #
#-----------------#
jobLab="[% levelId %].qcpi.casm"
jobCmd="[% stepDir %]/${jobLab}.cmd"
jobLog="[% stepDir %]/${jobLab}.jobID.log"
echo "# INFO - Submitting qcpi.casm ..." >&2
apptainer run --bind ${bindDir} ${contDir}/${perlCont} tpage \
--define qos=${qcpi_casm_qos} \
--define cpu=${qcpi_casm_cpu} \
--define mem=${qcpi_casm_mem} \
--define time="${qcpi_casm_time}" \
--define excludeNode=[% excludeNode %] \
--define jobLab=${jobLab} \
--define confFile=[% confFile %] \
--define stepDir=[% stepDir %] \
--define input=[% input %] \
--define levelId=[% levelId %] \
--define app="[% app %]" \
${ttDir}/${qcpi_casm_tt} > ${jobCmd}
casmJob=$(sbatch --parsable ${jobCmd})
if [ $? != 0 ]; then echo "ERROR : Cannot submit [${jobCmd}] [${cmdFile}]" >> ${errLog}; exit 1; fi
echo -e "${jobCmd}\t${casmJob}" | tee -a ${jobLog} >&2

#-----------------#
# qcpi.cism       #
#-----------------#
jobLab="[% levelId %].qcpi.cism"
jobCmd="[% stepDir %]/${jobLab}.cmd"
jobLog="[% stepDir %]/${jobLab}.jobID.log"
echo "# INFO - Submitting qcpi.cism ..." >&2
apptainer run --bind ${bindDir} ${contDir}/${perlCont} tpage \
--define qos=${qcpi_cism_qos} \
--define cpu=${qcpi_cism_cpu} \
--define mem=${qcpi_cism_mem} \
--define time="${qcpi_cism_time}" \
--define excludeNode=[% excludeNode %] \
--define jobLab=${jobLab} \
--define confFile=[% confFile %] \
--define stepDir=[% stepDir %] \
--define input=[% input %] \
--define levelId=[% levelId %] \
--define app="[% app %]" \
${ttDir}/${qcpi_cism_tt} > ${jobCmd}
cismJob=$(sbatch --parsable ${jobCmd})
if [ $? != 0 ]; then echo "ERROR : Cannot submit [${jobCmd}] [${cmdFile}]" >> ${errLog}; exit 1; fi
echo -e "${jobCmd}\t${cismJob}" | tee -a ${jobLog} >&2

