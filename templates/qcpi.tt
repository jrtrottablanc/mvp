${ttDir}/${qcpi_cbdbc_tt} > ${jobCmd}
cbdbcJob=$(sbatch --parsable ${jobCmd})
if [ $? != 0 ]; then echo "ERROR : Cannot submit [${jobCmd}] [${cmdFile}]" >> ${errLog}; exit 1; fi
echo -e "${jobCmd}\t${cbdbcJob}" | tee -a ${jobLog} >&2
	
#-----------------#
# qcpi.cogm       #
#-----------------#
jobLab="[% levelId %].qcpi.cogm"
jobCmd="[% stepDir %]/${jobLab}.cmd"
jobLog="[% stepDir %]/${jobLab}.jobID.log"
echo "# INFO - Submitting qcpi.cogm ..." >&2
apptainer run --bind ${bindDir} ${contDir}/${perlCont} tpage \
--define qos=${qcpi_cogm_qos} \
--define cpu=${qcpi_cogm_cpu} \
--define mem=${qcpi_cogm_mem} \
--define time="${qcpi_cogm_time}" \
--define excludeNode=[% excludeNode %] \
--define jobLab=${jobLab} \
--define confFile=[% confFile %] \
--define stepDir=[% stepDir %] \
--define input=[% input %] \
--define levelId=[% levelId %] \
--define app="[% app %]" \
${ttDir}/${qcpi_cogm_tt} > ${jobCmd}
cogmJob=$(sbatch --parsable ${jobCmd})
if [ $? != 0 ]; then echo "ERROR : Cannot submit [${jobCmd}] [${cmdFile}]" >> ${errLog}; exit 1; fi
